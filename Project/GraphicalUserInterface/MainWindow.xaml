<Window x:Class="PresentationView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PresentationView"
        xmlns:vm="clr-namespace:PresentationViewModel;assembly=PresentationViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BoardViewModel}">
            <local:Board />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MainWindowViewModel}">
            <Grid>
                <TextBlock x:Name="___GŁÓWNY_NAPIS_" HorizontalAlignment="Center" Margin="0,83,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="56" Width="175" FontSize="48" FontWeight="Bold"><Run Language="pl-pl" Text="BILARD"/></TextBlock>
                <TextBlock HorizontalAlignment="Left" Margin="72,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="370" Height="24" FontSize="16"><Run Language="pl-pl" Text="Wprowadź ilość kul która ma pojawić się na ekranie:"/></TextBlock>
                <TextBox Text="{Binding BallNumberInput, UpdateSourceTrigger=PropertyChanged}" x:Name="BallNumberInput" HorizontalAlignment="Left" Margin="442,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.049,-0.458"/>
                <Button Command="{Binding StartCommand}" x:Name="StartPresentation" Content="Uruchom program!" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
